# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env
# El archivo .env está en .gitignore: NUNCA lo subas a GitHub.

# ─── Datos del token ──────────────────────────────────────────────
TOKEN_NAME="Mi Memecoin"
TOKEN_SYMBOL="MEME"
# Suministro total en tokens enteros (el contrato añade los 18 decimales).
TOKEN_SUPPLY=1000000000
# Opcional: dirección que recibe todo el suministro (p. ej. una multisig Safe).
# Si se deja vacío, lo recibe la cuenta que despliega.
TOKEN_RECIPIENT=

# ─── Cuenta que despliega ─────────────────────────────────────────
# Recomendado: NO la pongas aquí; guárdala cifrada con
#   npx hardhat keystore set DEPLOYER_PRIVATE_KEY
# Usa una wallet nueva solo para desplegar, nunca tu wallet principal.
# DEPLOYER_PRIVATE_KEY=

# ─── Verificación en exploradores ─────────────────────────────────
# API key de https://etherscan.io/apidashboard (una sola key para todas las redes).
# ETHERSCAN_API_KEY=

# ─── RPCs (opcional: ya hay RPCs públicos por defecto) ────────────
# BASE_SEPOLIA_RPC_URL=
# SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=
# BASE_RPC_URL=
# MAINNET_RPC_URL=
# BSC_RPC_URL=
