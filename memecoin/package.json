    "@nomicfoundation/hardhat-verify": "^3.1.1",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "chai": "^5.3.3",
    "dotenv": "^18.0.4",
    "ethers": "^6.17.0",
    "hardhat": "^3.18.0",
    "mocha": "^12.0.2",
    "typescript": "~5.9"
